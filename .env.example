# ==========================================================================
# AI Study Hub — example environment file
# Copy this file to ".env" and fill in real values. Never commit ".env".
# ==========================================================================

# --- Core Django ---
# Generate a new key for production, e.g.:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=change-me
DEBUG=True
# For Railway: ALLOWED_HOSTS=your-app.up.railway.app,localhost,127.0.0.1
ALLOWED_HOSTS=localhost,127.0.0.1

# --- Database (PostgreSQL) ---
# Set USE_SQLITE=True only for a quick local trial; PostgreSQL is required
# for the final project.
#
# On Render: the platform injects a full DATABASE_URL connection string
# automatically (no need to set DB_* vars there). Local development can use
# either a DATABASE_URL or the individual DB_* variables below.
# DATABASE_URL=postgresql://user:password@host:port/dbname
USE_SQLITE=False
DB_NAME=ai_study_hub
DB_USER=postgres
DB_PASSWORD=your_db_password
DB_HOST=localhost
DB_PORT=5432

# --- Email ---
# Development default prints emails (verification / password reset links) to
# the console. For production, use the Brevo API (recommended) or SMTP.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend

# Brevo API (recommended for production - no SMTP timeout issues)
# Get your API key from: https://app.brevo.com/settings/keys/api
BREVO_API_KEY=your_brevo_api_key

# Legacy SMTP settings (optional fallback)
# EMAIL_HOST=smtp.example.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=your_smtp_user
# EMAIL_HOST_PASSWORD=your_smtp_password
# EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=AI Study Hub <no-reply@aistudyhub.local>

# Email verification is required by default. Set to False ONLY for demos
# without email service (not recommended for real production).
EMAIL_VERIFICATION_REQUIRED=True

# --- AI provider ---
# The AI service calls an OpenAI-compatible Chat Completions endpoint.
# Currently configured for Google Gemini (free tier, no billing required).
# Leave AI_API_KEY empty to use the built-in offline fallback assistant.
#
# Gemini OpenAI-compatible endpoint (no SDK needed):
AI_API_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# Free-tier Flash model — replace with any Gemini model you have access to:
AI_MODEL=gemini-3.6-flash
AI_API_KEY=your_api_key
AI_REQUEST_TIMEOUT=60
AI_MAX_TOKENS=800

# --- Media storage (Backblaze B2 / S3-compatible) ---
# Leave empty for local development (files stored in ./media/).
# Set all four for production on Railway.
# AWS_S3_ENDPOINT_URL format: https://s3.<region>.backblazeb2.com
# AWS_ACCESS_KEY_ID=your_key_id
# AWS_SECRET_ACCESS_KEY=your_application_key
# AWS_STORAGE_BUCKET_NAME=your_bucket_name
# AWS_S3_ENDPOINT_URL=https://s3.us-east-005.backblazeb2.com
